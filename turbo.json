{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["SITE_URL", "LLANG_RELEASE_ID", "VERCEL_ENV"],
  "globalDependencies": ["config/**", "results/**"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [] },
    "@llang-gap/web#build": { "dependsOn": ["^build"], "outputs": [".next/**", "out/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "dev": { "cache": false, "persistent": true }
  }
}
